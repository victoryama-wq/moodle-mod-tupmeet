{{!
    @template mod_tupmeet/recordings_table
    Server-filtered academic rows. Only managers receive POST fields and visibility icons.
    Example context (json):
    {"hasrows": true, "manage": false, "rows": [{"date": "19 Sep 2026", "hours": "11:23", "state": "Available"}]}
}}
<section class="mod-tupmeet-recordings" aria-labelledby="tupmeet-recordings-heading">
    <h2 id="tupmeet-recordings-heading" class="h4">{{#str}}classrecordings, mod_tupmeet{{/str}}</h2>
    {{^hasrows}}<p>{{#str}}classrecordingsnone, mod_tupmeet{{/str}}</p>{{/hasrows}}
    {{#hasrows}}
    <table class="table generaltable mod-tupmeet-recording-table" role="table">
        <caption class="mod-tupmeet-sr">{{#str}}classrecordings, mod_tupmeet{{/str}}</caption>
        <thead role="rowgroup"><tr role="row">
            <th scope="col" role="columnheader">{{#str}}recordingvideo, mod_tupmeet{{/str}}</th>
            <th scope="col" role="columnheader">{{#str}}recordingssession, mod_tupmeet{{/str}}</th>
            <th scope="col" role="columnheader">{{#str}}recordinghours, mod_tupmeet{{/str}}</th>
            <th scope="col" role="columnheader">{{#str}}recordingsstate, mod_tupmeet{{/str}}</th>
            <th scope="col" role="columnheader">{{#str}}recordingaction, mod_tupmeet{{/str}}</th>
            {{#manage}}<th scope="col" role="columnheader">{{#str}}recordingstudents, mod_tupmeet{{/str}}</th>{{/manage}}
        </tr></thead>
        <tbody role="rowgroup">
        {{#rows}}
            <tr role="row">
                <td role="cell"><span class="mod-tupmeet-play" aria-hidden="true">{{#pix}}t/play, core{{/pix}}</span></td>
                <th scope="row" role="rowheader">{{date}}{{#part}}<div class="small">{{part}}</div>{{/part}}</th>
                <td role="cell"><span class="mod-tupmeet-mobile-label" aria-hidden="true">{{#str}}recordinghours, mod_tupmeet{{/str}}: </span>{{hours}}</td>
                <td role="cell"><span class="mod-tupmeet-mobile-label" aria-hidden="true">{{#str}}recordingsstate, mod_tupmeet{{/str}}: </span>{{state}}</td>
                <td role="cell">
                    {{#filename}}<div class="small mb-2">{{filename}}</div>{{/filename}}
                    {{#url}}
                        <a href="{{url}}" class="btn btn-outline-primary mod-tupmeet-watch" target="_blank" rel="noopener noreferrer">
                            <span class="mod-tupmeet-play" aria-hidden="true">{{#pix}}t/play, core{{/pix}}</span>
                            {{#str}}recordingwatch, mod_tupmeet{{/str}}
                            <span class="mod-tupmeet-sr"> — {{date}} {{hours}} {{part}}; {{#str}}opensnewtab, mod_tupmeet{{/str}}</span>
                        </a>
                    {{/url}}
                </td>
                {{#manage}}
                <td role="cell">
                    <form action="{{actionurl}}" method="post" class="mod-tupmeet-visibility">
                        <input type="hidden" name="id" value="{{cmid}}">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="recordingid" value="{{recordingid}}">
                        <input type="hidden" name="action" value="{{action}}">
                        <button type="submit" class="btn btn-outline-secondary" title="{{visibilitylabel}}" aria-label="{{visibilitylabel}} — {{date}} {{hours}} {{part}}">
                            <span aria-hidden="true">{{{visibilityicon}}}</span>
                        </button>
                        <span class="small">{{visibilitystate}}</span>
                    </form>
                </td>
                {{/manage}}
            </tr>
        {{/rows}}
        </tbody>
    </table>
    {{{paging}}}
    {{/hasrows}}
</section>
