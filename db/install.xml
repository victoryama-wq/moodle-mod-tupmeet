<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/tupmeet/db" VERSION="2026091501" COMMENT="XMLDB file for mod_tupmeet"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="tupmeet" COMMENT="TUP Meet activity instances">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="startdatetime" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="enddatetime" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="isrecurring" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="recurrenceinterval" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="recurrencedays" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="[]"/>
        <FIELD NAME="recurrenceuntil" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="autorecord" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="autotranscript" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="publicationmode" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="manual"/>
        <FIELD NAME="accountid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Master account used when this meeting was created"/>
        <FIELD NAME="calendareventid" TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="meetspacename" TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="meetingcode" TYPE="char" LENGTH="64" NOTNULL="false"/>
        <FIELD NAME="meeturi" TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="lastsync" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timezone" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="UTC"/>
        <FIELD NAME="creationkey" TYPE="char" LENGTH="64" NOTNULL="false" COMMENT="Stable nonsecret submission key"/>
        <FIELD NAME="syncversion" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="legacy"/>
        <FIELD NAME="syncstatus" TYPE="char" LENGTH="12" NOTNULL="true" DEFAULT="legacy"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="accountid" UNIQUE="false" FIELDS="accountid"/>
        <INDEX NAME="calendareventid" UNIQUE="false" FIELDS="calendareventid"/>
        <INDEX NAME="creationkey" UNIQUE="true" FIELDS="creationkey"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="tupmeet_accounts" COMMENT="Master Google accounts known by TUP Meet; historical accounts are retained">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="displayname" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="googleemail" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="googlesub" TYPE="char" LENGTH="255" NOTNULL="false" COMMENT="Verified immutable Google OpenID subject; null until verified"/>
        <FIELD NAME="issuerid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Moodle OAuth2 issuer id"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="isdefault" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="connectionstatus" TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="pending"/>
        <FIELD NAME="timeverified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Last successful identity verification; not a live health status"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="googleemail" UNIQUE="false" FIELDS="googleemail"/>
        <INDEX NAME="defaultaccount" UNIQUE="false" FIELDS="isdefault,enabled"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
